@model Harmonia.Web.ViewModels.PasswordInput
@{ ViewData["Title"]="Đổi mật khẩu"; }
<div class="mx-auto my-5" style="max-width:480px"><h1 class="h3">Đổi mật khẩu</h1><p>Mật khẩu mới ít nhất 12 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt. Tài khoản dùng mật khẩu tạm phải đổi trước khi tiếp tục.</p>
<form asp-action="ChangePassword" method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label for="CurrentPassword">Mật khẩu hiện tại</label><input name="CurrentPassword" id="CurrentPassword" type="password" class="form-control mb-3" autocomplete="current-password" required />
<label for="NewPassword">Mật khẩu mới</label><input name="NewPassword" id="NewPassword" type="password" class="form-control mb-3" autocomplete="new-password" minlength="12" maxlength="128" required />
<label for="ConfirmPassword">Nhập lại mật khẩu mới</label><input name="ConfirmPassword" id="ConfirmPassword" type="password" class="form-control mb-3" autocomplete="new-password" required />
<button class="btn btn-primary">Đổi mật khẩu</button></form></div>
