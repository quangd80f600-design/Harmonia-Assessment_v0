@model Harmonia.Web.ViewModels.DashboardPage
@using Harmonia.Web.ViewModels
<section class="dashboard-calendar-group" aria-labelledby="dashboard-followups-title"><h3 id="dashboard-followups-title">Lịch đánh giá lại đã liên kết</h3><p class="text-muted small">Lịch lấy từ các đợt đánh giá đã liên kết với gói can thiệp; không phải ngày dự kiến riêng.</p>
@if(!Model.InterventionsEnabled){<p class="dashboard-empty">Chức năng can thiệp chưa được bật trong môi trường này.</p>}
else if(Model.Followups.Count==0){<p class="dashboard-empty">Chưa có lịch sắp tới hoặc đợt đã qua chưa ghi nhận kết quả trong phạm vi đang chọn.</p><a asp-controller="Interventions" asp-action="Index">Xem gói can thiệp và các lần đánh giá lại</a>}
<div class="dashboard-list">@foreach(var f in Model.Followups){<article class="dashboard-list-item"><div><p class="dashboard-eyebrow">@f.Date.ToString("dd/MM/yyyy") · @DashboardText.Followup(f,Model.Today)</p><h3><a asp-controller="Assessments" asp-action="Overview" asp-route-id="@f.FollowupId">@f.FollowupName</a></h3><p>@f.ClassName · Đợt nguồn: @f.BaselineName</p><div class="dashboard-row-actions">@foreach(var p in f.Packages){<a asp-controller="InterventionFollowups" asp-action="Index" asp-route-id="@p.Id">@p.Name</a>}@if(f.PackageCount>f.Packages.Count){<a asp-controller="Interventions" asp-action="Index">Xem các gói khác</a>}</div></div></article>}</div>
</section>
