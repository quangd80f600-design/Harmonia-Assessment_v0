@model IReadOnlyList<Harmonia.Web.ViewModels.ImportError>
@if (Model.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <p>Chưa nhập dữ liệu. Kiểm tra toàn bộ file và tải lên lại:</p>
        <ul class="mb-0">
        @foreach (var error in Model)
        {
            <li>@if (error.Line.HasValue) { <span>Dòng @error.Line · </span> } @error.Field: @error.Message</li>
        }
        </ul>
    </div>
}
