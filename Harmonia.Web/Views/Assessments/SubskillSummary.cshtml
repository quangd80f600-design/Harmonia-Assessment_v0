@model Harmonia.Web.ViewModels.AssessmentSubskillSummaryViewModel
@using System.Globalization
@using Harmonia.Web.ViewModels
@{
    ViewData["Title"] = "Phân tích kết quả đánh giá theo lớp";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var totals = new SubskillSummaryRow(0, "", "", Model.Rows.Sum(r => r.QuestionCount),
        Model.Rows.Sum(r => r.TotalResponses), Model.Rows.Sum(r => r.IncorrectResponses));
}
<div class="analysis-page">
    <header class="analysis-header">
        <nav aria-label="Đường dẫn"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách đợt đánh giá</a></li>
            <li class="breadcrumb-item active" aria-current="page">Phân tích lớp</li>
        </ol></nav>
        <h1>Phân tích kết quả đánh giá theo lớp</h1>
        <p class="analysis-description">Khám phá tỷ lệ sai theo từng đơn vị kiến thức và xem các câu hỏi liên quan.</p>
        <partial name="_AnalysisContext" model="Model.Assessment" />
        <a class="btn btn-outline-secondary btn-sm" asp-action="Overview" asp-route-id="@Model.Assessment.AssessmentId">Tổng quan đợt đánh giá</a>
        @if(ViewData["InterventionAssessmentId"] is long groupingAssessment && Context.RequestServices.GetService<Microsoft.Extensions.Options.IOptions<Harmonia.Web.Services.WorksheetOptions>>()?.Value.Enabled==true){<p class="mt-3"><a class="btn btn-primary" asp-controller="Worksheets" asp-action="ExactGroups" asp-route-assessmentId="@groupingAssessment">Tự chia nhóm ôn tập</a></p>}
        <partial name="_InterventionNextStep" />
    </header>
    <section class="analysis-section" aria-labelledby="overview-heading">
        <h2 id="overview-heading"><span class="section-number">01.</span> Tổng quan đợt đánh giá</h2>
        <p class="analysis-note">@Model.Rows.Count Subskill trong đề · Các thống kê phản ánh lượt trả lời đã ghi nhận, không phải tỷ lệ học sinh yếu.</p>
        <partial name="_AnalysisMetrics" model="totals" />
    </section>
    <section class="analysis-section" aria-labelledby="chart-heading">
        <h2 id="chart-heading"><span class="section-number">02.</span> Tỷ lệ trả lời sai theo nội dung kiến thức</h2>
        <p class="analysis-note">Xếp theo tỷ lệ sai giảm dần. Chọn tên hoặc thanh biểu đồ để xem câu hỏi.</p>
        @if (Model.Rows.Count == 0)
        {
            <p class="analysis-empty">Đề của đợt đánh giá này chưa có câu hỏi.</p>
        }
        else
        {
            <div class="analysis-scale" aria-hidden="true"><span>Tỷ lệ sai</span><span>0% — 100%</span></div>
            <ul class="analysis-chart">
            @foreach (var row in Model.Rows)
            {
                var label = row.ErrorPercentage is decimal pct ? pct.ToString("0.##", culture) + "%" : "Chưa có dữ liệu";
                <li>
                    <a class="analysis-chart-row" asp-action="QuestionDetail" asp-route-id="@Model.Assessment.AssessmentId" asp-route-subskillId="@row.SubskillId">
                        <span class="chart-label"><strong>@row.SubskillName</strong><small>@row.SubskillCode · @row.QuestionCount câu · @row.TotalResponses lượt trả lời</small></span>
                        <span class="chart-track @(row.ErrorPercentage is null ? "chart-track-missing" : "")" aria-hidden="true">
                            @if (row.ErrorPercentage is decimal width)
                            {
                                <span class="chart-fill" style="width: @(width.ToString(CultureInfo.InvariantCulture))%"></span>
                            }
                        </span>
                        <span class="chart-value">@label<span class="visually-hidden"> tỷ lệ sai. Xem câu hỏi.</span></span>
                    </a>
                    @if (ViewData["InterventionAssessmentId"] is long groupAssessment && Context.RequestServices.GetService<Microsoft.Extensions.Options.IOptions<Harmonia.Web.Services.WorksheetOptions>>()?.Value.Enabled == true)
                    { <a class="btn btn-outline-primary btn-sm mt-2" asp-controller="Worksheets" asp-action="Group" asp-route-assessmentId="@groupAssessment" asp-route-subskillId="@row.SubskillId">Chọn nhóm thủ công theo nội dung này</a> }
                </li>
            }
            </ul>
        }
    </section>
    <section class="analysis-section" aria-labelledby="table-heading">
        <h2 id="table-heading"><span class="section-number">03.</span> Bảng thống kê chi tiết</h2>
        <details class="analysis-details">
            <summary>Mở / thu gọn bảng thống kê (@Model.Rows.Count Subskill)</summary>
            <div class="table-responsive mt-3">
                <table class="table table-striped align-middle">
                    <caption>Số đếm theo Subskill của câu hỏi trong đề.</caption>
                    <thead><tr><th scope="col">Đơn vị kiến thức</th><th scope="col">Số câu</th><th scope="col">Lượt trả lời</th><th scope="col">Đúng</th><th scope="col">Sai</th><th scope="col">Tỷ lệ sai</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <th scope="row"><a asp-action="QuestionDetail" asp-route-id="@Model.Assessment.AssessmentId" asp-route-subskillId="@row.SubskillId">@row.SubskillName</a><small class="skill-code">@row.SubskillCode</small></th>
                            <td>@row.QuestionCount</td><td>@row.TotalResponses</td><td>@row.CorrectResponses</td><td>@row.IncorrectResponses</td>
                            <td>@(row.ErrorPercentage is decimal pct ? pct.ToString("0.##", culture) + "%" : "Chưa có dữ liệu")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    </section>
</div>
